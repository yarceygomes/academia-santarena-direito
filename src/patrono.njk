---
layout: layouts/base.njk
pagination:
  data: patronos.lista
  size: 1
  alias: p
permalink: "/patronos/{{ p.nome | slugify }}/"
eleventyComputed:
  title: "{{ p.nome }}"
  descricao: "Patrono da Cadeira nº {{ p.numero }} da Academia Santarena de Direito."
---
{% set c = cadeiras.cadeiras[p.numero - 1] %}
<article class="profile">
  <div class="container">
    <nav class="crumbs" aria-label="Trilha">
      <a href="/patronos/">Patronos</a> <span aria-hidden="true">/</span> Cadeira {{ p.numero }}
    </nav>

    <div class="profile__grid">
      <aside class="profile__side">
        {% if p.foto %}
        <figure class="profile__photo">
          <img src="{{ p.foto }}" alt="Retrato de {{ p.conhecidoComo or p.nome }}">
          <figcaption>{% if p.fotoFonte %}<a href="{{ p.fotoFonte }}" target="_blank" rel="noopener">{{ p.fotoCredito }}</a>{% else %}{{ p.fotoCredito }}{% endif %}</figcaption>
        </figure>
        {% elif p.pecas and p.pecas.length %}
        <figure class="archive-preview">
          <a href="#acervo-ilustrado"><img src="{{ p.pecas[0].img }}" alt="{{ p.pecas[0].titulo }}"></a>
          <figcaption><a href="#acervo-ilustrado">{{ p.pecas[0].titulo }}</a></figcaption>
        </figure>
        {% endif %}

        <dl class="profile__facts">
          <div><dt>Cadeira</dt><dd>nº {{ p.numero }}</dd></div>
          {% if c.ocupante %}<div><dt>Titular</dt><dd>{{ c.ocupante }}</dd></div>{% endif %}
          {% if p.nascimento %}<div><dt>Nascimento</dt><dd>{{ p.nascimento }}</dd></div>{% endif %}
          {% if p.falecimento %}<div><dt>Falecimento</dt><dd>{{ p.falecimento }}</dd></div>{% endif %}
        </dl>
      </aside>

      <div class="profile__main">
        <p class="kicker">Cadeira nº {{ p.numero }}</p>
        <h1>{{ p.nome }}</h1>
        {% if p.conhecidoComo or p.nomeCompleto %}<p class="profile__aka">{% if p.conhecidoComo %}Conhecido como {{ p.conhecidoComo }}{% else %}{{ p.nomeCompleto }}{% endif %}</p>{% endif %}
        {% if p.atividade %}<p class="profile__role">{{ p.atividade }}</p>{% endif %}

        {% if p.resumo %}<p class="profile__lead">{{ p.resumo }}</p>{% endif %}

        {% if p.biografia and p.biografia.length %}
        <section class="profile__section">
          <h2>Trajetória</h2>
          {% for paragrafo in p.biografia %}<p>{{ paragrafo }}</p>{% endfor %}
        </section>
        {% elif p.trajetoria and p.trajetoria.length %}
        <section class="profile__section">
          <h2>Trajetória</h2>
          <ul>{% for t in p.trajetoria %}<li>{{ t }}</li>{% endfor %}</ul>
        </section>
        {% endif %}

        {% if p.obras and p.obras.length %}
        <section class="profile__section">
          <h2>Obras</h2>
          <ul class="works">{% for o in p.obras %}<li>{{ o }}</li>{% endfor %}</ul>
        </section>
        {% endif %}

        {% if p.pecas and p.pecas.length %}
        <section class="profile__section archive" id="acervo-ilustrado">
          <h2>Acervo ilustrado</h2>
          {% for item in p.pecas %}
          <figure class="archive-piece">
            <a href="{{ item.fonte }}"><img src="{{ item.img }}" loading="lazy" alt="{{ item.titulo }}"></a>
            <figcaption><span class="kicker">{{ item.tipo }}</span>
              <strong>{{ item.titulo }}</strong><p>{{ item.legenda }}</p>
              <a href="{{ item.fonte }}">{{ item.credito }}</a>{% if item.licenca %} · <a href="{{ item.licencaUrl }}">{{ item.licenca }}</a>{% endif %}
            </figcaption>
          </figure>
          {% endfor %}
        </section>
        {% endif %}
        {% if p.registro %}
        <aside class="archive-note"><p class="kicker">{{ p.registro.tipo }} · {{ p.registro.ano }}</p>
          <h2>{{ p.registro.titulo }}</h2><p>{{ p.registro.texto }}</p>
          <a href="{{ p.registro.fonte }}">{{ p.registro.credito }}</a>
        </aside>
        {% endif %}
        {% if p.imagens and p.imagens.length %}
        <section class="profile__section">
          <h2>Iconografia</h2>
          {% for imagem in p.imagens %}
          <figure class="profile__photo">
            <img src="{{ imagem.url }}" alt="{{ imagem.alt }}" width="{{ imagem.largura }}" height="{{ imagem.altura }}" loading="lazy" style="width:100%;height:auto;aspect-ratio:auto;object-fit:contain">
            <figcaption>{{ imagem.legenda }} <a href="{{ imagem.fonte }}" target="_blank" rel="noopener">{{ imagem.credito }}</a>.</figcaption>
          </figure>
          {% endfor %}
        </section>
        {% endif %}

        {% if p.acervo and p.acervo.length %}
        <section class="profile__section">
          <h2>Documentos e imagens de acervo</h2>
          <ul>{% for item in p.acervo %}<li><a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.titulo }}</a></li>{% endfor %}</ul>
        </section>
        {% endif %}

        {% if p.situacao != "completo" %}
        <section class="profile__section profile__pending">
          <h2>Pesquisa em andamento</h2>
          {% if p.nota %}<p>{{ p.nota }}</p>{% endif %}
          <p>O acervo da Academia recebe documentos, fotografias e depoimentos sobre esta trajetória pela página de <a href="/contato/">contato</a>.</p>
        </section>
        {% endif %}

        {% if p.fontes and p.fontes.length %}
        <section class="profile__section">
          <h2>Fontes</h2>
          <ol class="sources">
            {% for f in p.fontes %}<li><a href="{{ f.url }}"{% if f.url.startsWith('http') %} target="_blank" rel="noopener"{% endif %}>{{ f.titulo }}</a></li>{% endfor %}
          </ol>
        </section>
        {% endif %}

        <nav class="profile__nav" aria-label="Outros patronos">
          {% if p.numero > 1 %}{% set ant = patronos.lista[p.numero - 2] %}<a href="/patronos/{{ ant.nome | slugify }}/">← Cadeira {{ ant.numero }} · {{ ant.conhecidoComo or ant.nome }}</a>{% else %}<span></span>{% endif %}
          {% if p.numero < patronos.lista.length %}{% set prox = patronos.lista[p.numero] %}<a href="/patronos/{{ prox.nome | slugify }}/">Cadeira {{ prox.numero }} · {{ prox.conhecidoComo or prox.nome }} →</a>{% endif %}
        </nav>
      </div>
    </div>
  </div>
</article>
