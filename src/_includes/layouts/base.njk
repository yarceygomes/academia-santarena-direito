{%- set menu = [
  { "url": "/academia/", "nome": "A Academia" },
  { "url": "/cadeiras/", "nome": "Cadeiras" },
  { "url": "/noticias/", "nome": "Notícias" },
  { "url": "/artigos/", "nome": "Artigos" },
  { "url": "/blog/", "nome": "Blog" },
  { "url": "/agenda/", "nome": "Agenda" },
  { "url": "/galeria/", "nome": "Galeria" }
] -%}
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.nome }}</title>
  <meta name="description" content="{{ (descricao or site.descricao) | semHtml }}">
  <meta property="og:title" content="{{ title or site.nome }}">
  <meta property="og:description" content="{{ (descricao or site.slogan) | semHtml }}">
  <meta property="og:image" content="{{ imagem or '/img/banner-posse.jpg' }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <header class="header" id="topo">
    <div class="container header__inner">
      <a href="/" class="logo" aria-label="{{ site.nome }}, início">
        <span class="logo__mark" aria-hidden="true">§</span>
        <span class="logo__text">
          <strong>Academia Santarena</strong>
          <small>de Direito</small>
        </span>
      </a>

      <button class="nav-toggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="menu">
        <span></span><span></span><span></span>
      </button>

      <nav class="nav" id="menu">
        {%- for item in menu %}
        <a href="{{ item.url }}"{% if page.url.startsWith(item.url) %} aria-current="page"{% endif %}>{{ item.nome }}</a>
        {%- endfor %}
        <a href="/busca/" class="nav__search" aria-label="Buscar no site">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="m20 20-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <span class="nav__search-label">Buscar</span>
        </a>
        <a href="/contato/" class="btn btn--small">Contato</a>
      </nav>
    </div>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="footer">
    <div class="container footer__grid">
      <div>
        <p class="footer__name">{{ site.nome }}</p>
        <p class="footer__motto">{{ site.lema }}</p>
        <p>{{ site.local }}</p>
      </div>
      <nav class="footer__links" aria-label="Rodapé">
        {%- for item in menu %}
        <a href="{{ item.url }}">{{ item.nome }}</a>
        {%- endfor %}
        <a href="/contato/">Contato</a>
      </nav>
      <div>
        <p><strong>Sede</strong><br>{{ site.sede }}</p>
        {% if site.contato.email %}<p><a href="mailto:{{ site.contato.email }}">{{ site.contato.email }}</a></p>{% endif %}
        {% if site.contato.instagram %}<p><a href="https://instagram.com/{{ site.contato.instagram }}">@{{ site.contato.instagram }}</a></p>{% endif %}
      </div>
    </div>
    <div class="container footer__bottom">
      <p>© <span id="year"></span> {{ site.sigla }} · {{ site.nome }}</p>
      <a href="/admin/">Área dos acadêmicos</a>
    </div>
  </footer>

  <script src="/js/main.js"></script>
</body>
</html>
