{%- set menu = [
  { "url": "/academia/", "nome": "A Academia" },
  { "url": "/cadeiras/", "nome": "Cadeiras" },
  { "url": "/patronos/", "nome": "Patronos" },
  { "url": "/noticias/", "nome": "Notícias" },
  { "url": "/artigos/", "nome": "Artigos" },
  { "url": "/blog/", "nome": "Blog" },
  { "url": "/agenda/", "nome": "Agenda" },
  { "url": "/galeria/", "nome": "Galeria" }
] -%}
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.nome }}</title>
  <meta name="description" content="{{ (descricao or site.descricao) | semHtml }}">
  <meta property="og:title" content="{{ title or site.nome }}">
  <meta property="og:description" content="{{ (descricao or site.slogan) | semHtml }}">
  <meta property="og:image" content="{{ imagem or '/img/banner-posse.jpg' }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="search-index" href="/busca.json">
</head>
<body>
  <a class="skip" href="#conteudo">Pular para o conteúdo</a>

  <div class="utility">
    <div class="container utility__inner">
      <span>{{ site.local }}</span>
      <nav aria-label="Acesso rápido">
        <a href="/busca/">Buscar</a>
        <a href="/contato/">Contato</a>
        <a href="/admin/">Área dos acadêmicos</a>
      </nav>
    </div>
  </div>

  <header class="masthead" id="topo">
    <div class="container masthead__inner">
      <a href="/" class="wordmark" aria-label="{{ site.nome }}, página inicial">
        <span class="wordmark__name">Academia Santarena de Direito</span>
        <span class="wordmark__sub">{{ site.lema }} · Fundada em 2026</span>
      </a>
      <button class="nav-toggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="menu">
        <span></span><span></span><span></span>
      </button>
    </div>
    <nav class="nav" id="menu" aria-label="Principal">
      <div class="container nav__inner">
        {%- for item in menu %}
        <a href="{{ item.url }}"{% if page.url.startsWith(item.url) %} aria-current="page"{% endif %}>{{ item.nome }}</a>
        {%- endfor %}
        <a href="/busca/" class="nav__mobile-only">Buscar</a>
        <a href="/contato/" class="nav__mobile-only">Contato</a>
      </div>
    </nav>
  </header>

  <main id="conteudo">
    {{ content | safe }}
  </main>

  <footer class="footer">
    <div class="container footer__grid">
      <div class="footer__about">
        <p class="footer__name">Academia Santarena de Direito</p>
        <p>{{ site.slogan }}</p>
        <p class="footer__motto">{{ site.lema }}</p>
      </div>
      <div>
        <h2 class="footer__title">Instituição</h2>
        <ul>
          <li><a href="/academia/">A Academia</a></li>
          <li><a href="/academia/#diretoria">Diretoria</a></li>
          <li><a href="/cadeiras/">Cadeiras</a></li>
          <li><a href="/patronos/">Patronos</a></li>
        </ul>
      </div>
      <div>
        <h2 class="footer__title">Publicações</h2>
        <ul>
          <li><a href="/noticias/">Notícias</a></li>
          <li><a href="/artigos/">Artigos</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/agenda/">Agenda</a></li>
          <li><a href="/galeria/">Galeria</a></li>
        </ul>
      </div>
      <div>
        <h2 class="footer__title">Contato</h2>
        <ul>
          <li>{{ site.sede }}</li>
          {% if site.contato.email %}<li><a href="mailto:{{ site.contato.email }}">{{ site.contato.email }}</a></li>{% endif %}
          <li><a href="/contato/">Fale com a Academia</a></li>
        </ul>
      </div>
    </div>
    <div class="container footer__bottom">
      <p>© <span id="year"></span> Academia Santarena de Direito</p>
      <p><a href="/admin/">Área dos acadêmicos</a></p>
    </div>
  </footer>

  <script src="/js/main.js"></script>
</body>
</html>
